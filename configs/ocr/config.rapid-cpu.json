{
  "variant_id": "ppocrv5-server-local-bg-v3-cpu",
  "backend": "rapidocr",
  "empty_detection_policy": "error",
  "rapidocr": {
    "Det.limit_side_len": 1600,
    "Det.limit_type": "max",
    "Det.mean": [0.485, 0.456, 0.406],
    "Det.std": [0.229, 0.224, 0.225],
    "Det.thresh": 0.3,
    "Det.box_thresh": 0.5,
    "Det.unclip_ratio": 1.5,
    "Det.use_dilation": false,
    "EngineConfig.onnxruntime.intra_op_num_threads": 4,
    "EngineConfig.onnxruntime.inter_op_num_threads": 1
  },
  "expand_pixels": 2,
  "fill_rgb": [128,128,128],
  "fill": {"method": "local-background", "ring_pixels": 6, "dominant_fraction": 0.55, "inpaint_radius": 3}
}
